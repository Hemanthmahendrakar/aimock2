# Copy this file to .env for local development. Never commit the real .env.

FLASK_ENV=development

# --- Secrets (generate real random values — these are placeholders) ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mock_interview_dev
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mock_interview_test
DB_POOL_SIZE=10

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Cookies / JWT ---
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=

# --- Token TTLs ---
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# --- Frontend origin (for CORS + email links) ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Mail (console for development; SMTP or AWS SES for real delivery) ---
MAIL_PROVIDER=console
MAIL_FROM_ADDRESS=no-reply@example.com
# Optional production email configuration (MAIL_PROVIDER=console|smtp|ses)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_SES_REGION=

# --- Local filesystem uploads ---
# In Docker Compose this directory is bind-mounted to ./storage/uploads on the host.
FILE_STORAGE_ROOT=/app/storage/uploads
S3_SIGNED_URL_TTL_SECONDS=3600
LOGO_MAX_SIZE_BYTES=2097152

# --- AI Gateway (Phase 8) ---
# AI_PROVIDER=none uses the offline heuristic provider (no API key
# needed). Set AI_PROVIDER=anthropic + AI_API_KEY to use real AI —
# falls back to heuristic automatically on any failure.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_API_BASE_URL=https://api.anthropic.com
AI_REQUEST_TIMEOUT_SECONDS=30

# --- Question Engine (Phase 8) ---
QUESTIONS_PER_ROUND_TARGET=3
MAX_QUESTIONS_PER_ROUND=6

# --- Voice + Avatar (Phase 13) ---
# All default to "none" (safe, no network calls, no credentials needed).
STT_PROVIDER=none
STT_API_KEY=
STT_API_BASE_URL=https://api.openai.com
STT_MODEL=whisper-1

TTS_PROVIDER=none
TTS_API_KEY=
TTS_API_BASE_URL=https://api.elevenlabs.io
TTS_DEFAULT_VOICE_ID=

AVATAR_PROVIDER=none
AVATAR_API_KEY=
AVATAR_API_BASE_URL=
AVATAR_DEFAULT_ID=

VOICE_REQUEST_TIMEOUT_SECONDS=30
MAX_ANSWER_AUDIO_SIZE_BYTES=10485760

# --- Resume uploads ---
RESUME_MAX_SIZE_BYTES=5242880

# --- Interview access / session tokens (Phase 7) ---
INTERVIEW_ACCESS_TOKEN_TTL_DAYS=14
INTERVIEW_SESSION_TOKEN_TTL_HOURS=3

# --- Celery (background jobs) ---
# Leave false for docker-compose (real worker container handles jobs).
# Set true only for local scripts/tests that need synchronous execution.
CELERY_TASK_ALWAYS_EAGER=false

# --- Observability ---
SENTRY_DSN=
POSTHOG_API_KEY=
